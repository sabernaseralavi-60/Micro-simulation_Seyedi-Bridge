# --- Python ---
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- SUMO raw simulation outputs (only summarized parquet/csv are committed) ---
out/
outputs/logs/*.xml
scenarios/**/out/
scenarios/_diagnostics/
scenarios/**/*.xml
!scenarios/**/*.rou.xml
!scenarios/**/*.sumocfg
!scenarios/**/*.net.xml

# raw tripinfo/summary/ssm/fcd dumps — never commit raw XML telemetry
**/tripinfo*.xml
**/summary*.xml
**/stats*.xml
**/ssm*.xml
**/fcd*.xml
**/emission*.xml

# per-vehicle multi-run table (130k+ rows, effectively raw, not a summary) —
# only the per-seed and per-lambda aggregated summaries are committed
outputs/tables/*_multirun_tripinfo.parquet

# --- Quarto ---
/report/_site/
/report/_output/
/report/.quarto/
*_files/
*.knit.md
*.utf8.md
report/*.log
report/report-fa.tex
report/report-en.tex
report/*_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
*.swp

# --- credentials ---
.env
token.txt
*.token
*_token.txt
