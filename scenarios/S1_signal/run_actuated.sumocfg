<?xml version="1.0" encoding="UTF-8"?>
<!--
  سناریوی S1 (نسخهٔ actuated) — تقاطع چراغ‌دار با کنترل تطبیقی gap-out پیش‌فرض SUMO.
  رجوع به config/assumptions.yml -> signal_design_S1 و
  scenarios/S1_signal/README.md برای منطق طراحی کامل.
  مدل کالیبره‌نشده — نتایج صرفاً برای مقایسهٔ نسبی سناریوها معتبرند.
  توجه: اجرای چند-λ×چند-seed واقعی از src/04_run_experiments.py طبق
  config/scenarios.yml انجام می‌شود؛ این فایل صرفاً برای اجرای دستی/بازرسی
  چشمی تکی (netedit یا sumo-gui) با تقاضای مبنای فاز ۱-۲ است.
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="network/seyedi_S1_actuated.net.xml"/>
        <route-files value="../../demand/routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="4500"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <collision.action value="warn"/>
    </processing>

    <report>
        <no-warnings value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</configuration>
